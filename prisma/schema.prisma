generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ===== ENUMS =====
enum Role {
  ADMIN
  MEMBER
}

enum FundType {
  MMF
  STOCK
  BOND
  FIXED_DEPOSIT
  SAVINGS
  JUNIOR
}

enum ProductCategory {
  MONEY_MARKET
  EQUITY
  FIXED_INCOME
  FIXED_DEPOSIT
  SAVINGS
  JUNIOR
}

enum InvestmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  FAILED
}

enum PaymentMethod {
  MPESA
  STRIPE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  DIVIDEND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum NotificationType {
  SYSTEM
  INVESTMENT
  PAYMENT
  KYC
  MESSAGE
}

enum DocumentType {
  FILE
  CONTENT
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountType {
  INDIVIDUAL
  TEAM
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum InvestmentScope {
  PERSONAL
  POOLED
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  UNEMPLOYED
  RETIRED
  STUDENT
}

// ===== MODELS =====
model User {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  clerkId             String      @unique
  email               String      @unique
  fullName            String?
  phone               String?
  nationalId          String?
  dateOfBirth         DateTime?

  // ✅ Enhanced place of birth
  placeOfBirthCounty     String?
  placeOfBirthSubCounty  String?
  placeOfBirthWard       String?

  // Legacy field kept for backward compat
  countyOfBirth       String?
  countyOfResidence   String?

  // ✅ Residential address
  residentialAddress  String?

  ludevaNumber        String?
  maritalStatus       String?
  numberOfKids        Int?

  // ✅ KRA PIN & Source of Funds
  kraPin              String?
  sourceOfFunds       String?

  // ✅ Employment
  employmentStatus    EmploymentStatus?
  professionalBackground String?
  currentOccupation   String?

  // ✅ Team name (for TEAM account type)
  teamName            String?

  // ✅ Document uploads (selfie & ID)
  selfieUrl           String?
  idCopyUrl           String?

  // ✅ Investment Application Form (uploaded during KYC onboarding)
  investmentFormUrl   String?

  // ✅ Chosen lock-in period for the initial investment, in years (1, 2, 3, 5, 7, or 10)
  lockInYears         Int?

  // ✅ Primary Beneficiary
  primaryBeneficiaryName      String?
  primaryBeneficiaryPercentage Float?
  primaryBeneficiaryIdNumber  String?
  primaryBeneficiaryEmail     String?
  primaryBeneficiaryPhone     String?
  primaryBeneficiaryIdUrl     String?

  // ✅ Secondary Beneficiary
  secondaryBeneficiaryName      String?
  secondaryBeneficiaryPercentage Float?
  secondaryBeneficiaryIdNumber  String?
  secondaryBeneficiaryPhone     String?
  secondaryBeneficiaryIdUrl     String?

  nextOfKinName       String?
  nextOfKinPhone      String?
  nextOfKinEmail      String?
  initialInvestment   Int?
  role                Role        @default(MEMBER)
  onboardingCompleted Boolean     @default(false)
  accountType         AccountType @default(INDIVIDUAL)

  kycStatus      KycStatus @default(PENDING)
  kycSubmittedAt DateTime?

  investments   Investment[]
  payments      Payment[]
  transactions  Transaction[]
  notifications Notification[]
  documents     Document[]
  analyticsUploads TeamAnalytics[] @relation("AnalyticsUploads")

  // Chat relations
  memberChats  ChatRoom[] @relation("MemberChats")
  adminChats   ChatRoom[] @relation("AdminChats")
  sentMessages Message[]  @relation("SentMessages")

  // ✅ Team panel relations
  ownedTeam       Team?            @relation("TeamOwner")
  teamMembership  TeamMembership?  @relation("TeamMembershipUser")
  sentInvites     TeamInvite[]     @relation("TeamInvitesSentBy")

  // ✅ Ludeva Junior Account applications submitted as a guardian, and (for
  // admins) the ones they've reviewed.
  juniorApplications         JuniorAccountApplication[] @relation("JuniorGuardian")
  juniorApplicationsReviewed JuniorAccountApplication[] @relation("JuniorReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

// ─────────────────────────────────────────────
// Team Panel
// A Team is created by the member who signs up as AccountType.TEAM
// (the "owner"). The owner invites other members by email; once a
// member accepts their invite, a TeamMembership links them to the
// team with their own custom permission set, and they get access to
// the shared team dashboard/services under the same team.
// ─────────────────────────────────────────────
model Team {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  ownerId String @unique @db.ObjectId
  owner   User   @relation("TeamOwner", fields: [ownerId], references: [id])

  members TeamMembership[]
  invites TeamInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team")
}

// ✅ Per-member custom permissions within a team. Owner implicitly has
// every permission — these flags apply to invited members. All default
// to false so a newly invited member only gets what the inviter grants.
model TeamMembership {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  teamId String @db.ObjectId
  userId String @unique @db.ObjectId

  team Team @relation(fields: [teamId], references: [id])
  user User @relation("TeamMembershipUser", fields: [userId], references: [id])

  // Custom permissions (owner always has full access regardless of these)
  canInvite          Boolean @default(false) // generate/send new invite links
  canManagePermissions Boolean @default(false) // edit other members' permissions
  canRemoveMembers   Boolean @default(false) // remove members from the team
  canInvestPooled    Boolean @default(true)  // contribute to the shared team investment
  canViewPooledFunds Boolean @default(true)  // view the shared/pooled investment balance
  canViewAllReports  Boolean @default(false) // view every member's personal reports, not just their own
  canWithdraw        Boolean @default(false) // request withdrawals from pooled funds
  canManageAnalytics Boolean @default(false) // upload/manage team analytics documents

  joinedAt DateTime @default(now())

  @@map("teammembership")
}

// ✅ An invite is created with the target email + the permission set the
// inviter wants that person to have once they accept. Token is emailed
// via a link; accepting requires signing in/up with that same email.
model TeamInvite {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  teamId String @db.ObjectId
  team   Team   @relation(fields: [teamId], references: [id])

  email       String
  token       String           @unique
  status      TeamInviteStatus @default(PENDING)
  invitedById String           @db.ObjectId
  invitedBy   User             @relation("TeamInvitesSentBy", fields: [invitedById], references: [id])

  // Permissions to grant on acceptance — mirrors TeamMembership flags
  canInvite            Boolean @default(false)
  canManagePermissions Boolean @default(false)
  canRemoveMembers     Boolean @default(false)
  canInvestPooled      Boolean @default(true)
  canViewPooledFunds   Boolean @default(true)
  canViewAllReports    Boolean @default(false)
  canWithdraw          Boolean @default(false)
  canManageAnalytics   Boolean @default(false)

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teaminvite")
}

model ChatRoom {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  memberId String @db.ObjectId
  adminId  String @db.ObjectId

  member User @relation("MemberChats", fields: [memberId], references: [id])
  admin  User @relation("AdminChats", fields: [adminId], references: [id])

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, adminId])
  @@map("chatroom")
}

model Message {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  roomId   String  @db.ObjectId
  senderId String  @db.ObjectId
  content  String
  read     Boolean @default(false)

  room   ChatRoom @relation(fields: [roomId], references: [id])
  sender User     @relation("SentMessages", fields: [senderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("message")
}

model TeamAnalytics {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  label       String
  fileName    String
  fileUrl     String
  fileType    String
  headers     String[]
  rows        String
  uploadedById String  @db.ObjectId
  uploadedBy   User    @relation("AnalyticsUploads", fields: [uploadedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("teamanalytics")
}

model Investment {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  productId String           @db.ObjectId
  amount    Float
  fundType  FundType
  status    InvestmentStatus @default(PENDING)

  productName String
  roi         Float
  duration    Int

  // ✅ Team panel: who this investment belongs to, personal vs pooled.
  // userId always stays the member who initiated/paid for it. When
  // scope is POOLED, teamId is set and the amount counts toward the
  // team's shared balance; when PERSONAL, it's only that member's own.
  teamId String?         @db.ObjectId
  scope  InvestmentScope @default(PERSONAL)

  user     User              @relation(fields: [userId], references: [id])
  product  InvestmentProduct @relation(fields: [productId], references: [id])
  payments Payment[]         @relation(name: "PaymentInvestment")

  createdAt DateTime @default(now())

  @@map("investment")
}

model InvestmentProduct {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  type            FundType
  category        ProductCategory
  description     String?
  roi             Float
  roiMax          Float? // optional upper bound, for range display e.g. "9–13% p.a."
  duration        Int
  minAmount       Float
  maxAmount       Float?
  isActive        Boolean         @default(true)
  nav             Float?
  activeInvestors Int?            @default(0)
  inceptionDate   DateTime?
  investments     Investment[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("investmentproduct")
}

model Payment {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  userId            String        @db.ObjectId
  investmentId      String?       @db.ObjectId
  amount            Float
  currency          String        @default("KES")
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  reference         String        @unique
  providerReference String?
  merchantRequestID String?
  description       String?

  user       User        @relation(fields: [userId], references: [id])
  investment Investment? @relation(fields: [investmentId], references: [id], name: "PaymentInvestment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  userId    String            @db.ObjectId
  user      User              @relation(fields: [userId], references: [id])
  type      TransactionType
  amount    Float
  status    TransactionStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("transaction")
}

enum NotificationAudience {
  MEMBER
  ADMIN
  ALL
}

model Notification {
  id        String               @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?              @db.ObjectId
  title     String
  message   String
  type      NotificationType     @default(SYSTEM)
  audience  NotificationAudience @default(ALL)
  isRead    Boolean              @default(false)
  user      User?                @relation(fields: [userId], references: [id])
  createdAt DateTime             @default(now())

  @@map("notification")
}

model Document {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  type        DocumentType
  fileUrl     String?
  fileName    String?
  content     String?
  mediaType   String?
  isPublished Boolean      @default(true)
  createdById String       @db.ObjectId
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ✅ Per-member MMF performance records pushed from Google Sheets
model MemberReport {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  
  // Identifies which member this row belongs to
  memberEmail String
  accountNo   String?  // e.g. LA0061
  memberName  String?
  
  // Performance data columns (matching CSV structure)
  date        String?   // DATE column
  principal   String?   // PRIN
  rate        String?   // RATE
  roi         String?   // ROI
  withdrawal  String?   // WITH
  closingBal  String?   // CLOSING BAL
  quarter     String?   // e.g. Q1, Q2 label rows
  notes       String?   // any extra notes
  
  // Period label (e.g. "2025, 11.5% Net")
  periodLabel String?
  
  // Meta
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("memberreport")
}

// ─────────────────────────────────────────────
// Ludeva Junior Account application — a parent/guardian applies on behalf
// of a child. Reviewed manually by an admin (documents are real KYC:
// birth certificate + child's passport photo, plus the guardian's own
// ID/passport, phone, and KRA PIN). Files are uploaded via the same R2
// pipeline as the adult KYC flow (see /api/upload-kyc-doc), so these
// fields hold public R2 URLs, not raw file data.
//
// Approval doesn't create a separate ledger record — it flips the
// application to APPROVED, which /api/investments checks before letting
// the guardian invest into the active JUNIOR product on the child's
// behalf (see the JUNIOR gate in that route).
// ─────────────────────────────────────────────
enum JuniorApplicationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model JuniorAccountApplication {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  guardianId String @db.ObjectId
  guardian   User   @relation("JuniorGuardian", fields: [guardianId], references: [id])

  childFullName    String
  childDateOfBirth DateTime?

  guardianIdNumber String
  guardianPhone    String
  guardianKraPin   String

  birthCertUrl  String // R2 URL
  childPhotoUrl String // R2 URL

  status       JuniorApplicationStatus @default(PENDING_REVIEW)
  reviewNotes  String?
  reviewedById String?                 @db.ObjectId
  reviewedBy   User?                   @relation("JuniorReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("junioraccountapplication")
}
